# Store text files with LF in the repo; shell scripts and Dockerfiles must stay LF
# even on Windows checkouts, or they break inside Linux containers.
* text=auto
*.sh text eol=lf
Dockerfile text eol=lf

# Vendored apertium-krc is built in Linux containers straight from the working tree,
# so its text files must stay LF on Windows too. text=auto leaves binaries (krc.prob) alone.
lexicon/** text=auto eol=lf
